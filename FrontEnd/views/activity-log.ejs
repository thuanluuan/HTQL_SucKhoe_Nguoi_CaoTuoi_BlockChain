<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link
      <!DOCTYPE html>
      <html lang="vi">
        <head>
          <meta charset="UTF-8" />
          <meta name="viewport" content="width=device-width, initial-scale=1.0" />
          <title><%= title %></title>
          <link
            rel="stylesheet"
            href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
          />
          <link rel="stylesheet" href="/css/style.css" />
          <link rel="stylesheet" href="/css/header-features.css" />
          <style>
            .log-container {
              background: var(--card-bg);
              border-radius: 16px;
              padding: 1.5rem;
              border: 1px solid var(--border-color);
              box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
            }

            .log-filters {
              display: flex;
              gap: 1rem;
              margin-bottom: 2rem;
              flex-wrap: wrap;
            }

            .filter-group {
              display: flex;
              align-items: center;
              background: rgba(255, 255, 255, 0.05);
              border: 1px solid var(--border-color);
              border-radius: 8px;
              padding: 0.5rem 1rem;
            }

            .filter-group i {
              color: var(--text-secondary);
              margin-right: 0.5rem;
            }

            .filter-input {
              background: transparent;
              border: none;
              color: var(--text-primary);
              outline: none;
              font-family: inherit;
            }

            .log-table {
              width: 100%;
              border-collapse: collapse;
            }

            .log-table th {
              text-align: left;
              padding: 1rem;
              color: var(--text-secondary);
              font-weight: 500;
              border-bottom: 1px solid var(--border-color);
            }

            .log-table td {
              padding: 1rem;
              border-bottom: 1px solid var(--border-color);
              color: var(--text-primary);
            }

            .log-table tr:hover {
              background: rgba(255, 255, 255, 0.02);
            }

            .patient-link {
              color: var(--text-primary);
              text-decoration: none;
              font-weight: 600;
            }

            .patient-link:hover {
              color: var(--accent-cyan);
            }

            .verify-btn {
              background: rgba(255, 255, 255, 0.08);
              color: var(--text-primary);
              border: 1px solid var(--border-color);
              padding: 6px 12px;
              border-radius: 999px;
              cursor: pointer;
              font-size: 0.85rem;
            }

            .verify-btn:hover {
              border-color: var(--accent-cyan);
              color: var(--accent-cyan);
            }

            .status-pill {
              display: inline-flex;
              align-items: center;
              gap: 6px;
              padding: 4px 10px;
              border-radius: 999px;
              font-size: 0.8rem;
              border: 1px solid transparent;
            }

            .status-ok {
              color: #2ed573;
              border-color: rgba(46, 213, 115, 0.4);
              background: rgba(46, 213, 115, 0.12);
            }

            .status-warn {
              color: #ff4757;
              border-color: rgba(255, 71, 87, 0.4);
              background: rgba(255, 71, 87, 0.12);
            }
          </style>
        </head>
        <body>
          <%- include('partials/sidebar') %>

          <main class="main-content">
            <%- include('partials/header') %>

            <div style="padding: 0 2rem; margin-bottom: 2rem">
              <div class="page-header" style="margin-bottom: 2rem">
                <h1 style="font-size: 1.8rem; margin-bottom: 0.5rem">
                  Quản lý bệnh nhân
                </h1>
                <p style="color: var(--text-secondary)">
                  Danh sách bệnh nhân và chi tiết hồ sơ.
                </p>
              </div>

              <div class="log-container">
                <div class="log-filters">
                  <div class="filter-group">
                    <i class="fas fa-search"></i>
                    <input
                      type="text"
                      class="filter-input"
                      placeholder="Tìm kiếm theo tên/CCCD/SĐT"
                      style="width: 280px"
                      oninput="filterPatients(this.value)"
                    />
                  </div>
                  <a
                    href="/create-patient"
                    class="btn btn-primary"
                    style="margin-left: auto; text-decoration: none"
                  >
                    <i class="fas fa-user-plus"></i> Thêm bệnh nhân
                  </a>
                </div>

                <table class="log-table" id="patientsTable">
                  <thead>
                    <tr>
                      <th>Họ và Tên</th>
                      <th>CCCD</th>
                      <th>Số ĐT</th>
                      <th>Ngày Sinh</th>
                      <th>Ngày tạo</th>
                      <th>Kiểm tra Blockchain</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% if (patients && patients.length > 0) { %>
                      <% patients.forEach(function(p) { %>
                        <tr class="patient-row">
                          <td>
                            <a class="patient-link" href="/patient/<%= p.cccd %>">
                              <%= p.fullName %>
                            </a>
                          </td>
                          <td><%= p.cccd %></td>
                          <td><%= p.phone || 'N/A' %></td>
                          <td><%= p.birthDate || 'N/A' %></td>
                          <td><%= p.createdAt ? p.createdAt.toLocaleDateString('vi-VN') : 'N/A' %></td>
                          <td>
                            <div style="display: flex; gap: 10px; align-items: center">
                              <button
                                class="verify-btn"
                                type="button"
                                onclick="verifyPatient(this)"
                                data-patient-key="<%= p.patientIndexKey || '' %>"
                              >
                                <i class="fas fa-shield-alt"></i> Kiểm tra
                              </button>
                              <span class="status-pill <%= p.isVerified ? 'status-ok' : 'status-warn' %>">
                                <i class="fas <%= p.isVerified ? 'fa-check-circle' : 'fa-exclamation-circle' %>"></i>
                                <%= p.isVerified ? 'Có hồ sơ on-chain' : 'Chưa có hồ sơ on-chain' %>
                              </span>
                            </div>
                          </td>
                        </tr>
                      <% }); %>
                    <% } else { %>
                      <tr>
                        <td colspan="6" style="text-align: center; color: var(--text-secondary)">
                          Chưa có bệnh nhân.
                        </td>
                      </tr>
                    <% } %>
                  </tbody>
                </table>
              </div>
            </div>
          </main>

          <script>
            async function verifyPatient(btn) {
              try {
                const patientKey = btn.getAttribute("data-patient-key") || "";
                if (!patientKey) {
                  alert("Thiếu patientKey của bệnh nhân.");
                  return;
                }

                btn.disabled = true;
                const originalText = btn.innerHTML;
                btn.innerHTML =
                  '<i class="fas fa-spinner fa-spin"></i> Đang kiểm tra';

                const response = await fetch(
                  `/api/patient-records?patientKey=${encodeURIComponent(patientKey)}`,
                );
                const result = await response.json();
                const recordCount = Array.isArray(result.recordIds)
                  ? result.recordIds.length
                  : 0;

                const statusPill = btn.parentElement.querySelector(".status-pill");
                if (recordCount > 0) {
                  if (statusPill) {
                    statusPill.classList.remove("status-warn");
                    statusPill.classList.add("status-ok");
                    statusPill.innerHTML =
                      '<i class="fas fa-check-circle"></i> Có hồ sơ on-chain';
                  }
                  alert("Bệnh nhân đã có hồ sơ on-chain.");
                } else {
                  if (statusPill) {
                    statusPill.classList.remove("status-ok");
                    statusPill.classList.add("status-warn");
                    statusPill.innerHTML =
                      '<i class="fas fa-triangle-exclamation"></i> Chưa có hồ sơ on-chain';
                  }
                  alert("Chưa có hồ sơ on-chain cho bệnh nhân này.");
                }

                btn.innerHTML = originalText;
                btn.disabled = false;
              } catch (error) {
                console.error(error);
                alert("Không thể kiểm tra Blockchain.");
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-shield-alt"></i> Kiểm tra';
              }
            }

            function filterPatients(value) {
              const keyword = value.trim().toLowerCase();
              const rows = document.querySelectorAll(".patient-row");
              rows.forEach((row) => {
                const text = row.innerText.toLowerCase();
                row.style.display = text.includes(keyword) ? "" : "none";
              });
            }
          </script>
        </body>
      </html>
    </script>
  </body>
</html>
